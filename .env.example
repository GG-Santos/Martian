# MongoDB Atlas connection string used by Prisma. Keep credentials local.
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority"

# Upstash Redis TCP connection URL used server-side for realtime rooms.
REDIS_URL=rediss://default:REPLACE_WITH_UPSTASH_TOKEN@REPLACE_WITH_UPSTASH_HOST:6379
